[[local|localrc]]
# Lab passwords only. Never use these passwords in production.
ADMIN_PASSWORD=openstack
DATABASE_PASSWORD=openstack
RABBIT_PASSWORD=openstack
SERVICE_PASSWORD=openstack
HOST_IP=REPLACE_WITH_UBUNTU_VM_IP

enable_service key mysql rabbit
enable_service g-api g-reg
enable_service n-api n-cpu n-cond n-sch n-novnc
enable_service placement-api
enable_service q-svc q-agt q-dhcp q-l3 q-meta
enable_service c-api c-vol c-sch
enable_service horizon

disable_service tempest
disable_service s-account s-container s-object s-proxy
disable_service heat h-api h-api-cfn h-api-cw h-eng

Q_AGENT=openvswitch
Q_ML2_TENANT_NETWORK_TYPE=vxlan
Q_USE_PROVIDERNET_FOR_PUBLIC=True
PUBLIC_INTERFACE=eth0
CINDER_ENABLED_BACKENDS=lvm
CINDER_BACKING_FILE_SIZE=20G
#LIBVIRT_TYPE=qemu
